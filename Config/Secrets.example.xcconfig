// Copy this file to Secrets.xcconfig (same folder) and fill in the two values
// from Supabase: Project Settings → API.
// Use the "anon" / "publishable" key only. NEVER the service_role key.
// Note: in .xcconfig files, write "https:/$()/" instead of "https://".

SUPABASE_URL = https:/$()/YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// PostHog analytics: Project Settings → Project token (starts with phc_) and the host.
POSTHOG_PROJECT_TOKEN = phc_YOUR-PROJECT-TOKEN
POSTHOG_HOST = https:/$()/us.i.posthog.com
