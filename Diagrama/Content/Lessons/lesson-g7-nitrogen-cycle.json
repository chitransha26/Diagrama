 "steps": [
  {
   "type": "trace",
   "title": "Soil",
   "structure": "soil",
   "instruction": "Draw the soil line.",
   "note": {
    "text": "About 78% of the air is nitrogen gas. Living things need nitrogen to build proteins and DNA."
   }
  },
  {
   "type": "trace",
   "title": "Bean plant",
   "structure": "plant",
   "instruction": "Trace the bean plant.",
   "note": {
    "text": "Plants and animals can't use nitrogen gas straight from the air.",
    "remember": "Nitrogen gas: not usable directly."
   }
  },
  {
   "type": "trace",
   "title": "Roots",
   "structure": "roots",
   "instruction": "Trace the roots.",
   "note": {
    "text": "Bean and pea plants are legumes. Their roots have bumps called nodules."
   }
  },
  {
   "type": "trace",
   "title": "Nodules",
   "structure": "roots",
   "part": "details",
   "instruction": "Dab the three nodules on the roots.",
   "note": {
    "text": "Bacteria living inside the nodules turn nitrogen gas into a form plants can use."
   }
  },
  {
   "type": "trace",
   "title": "Nitrogen fixation",
   "structure": "fix",
   "instruction": "Draw the arrow from the air to the nodules.",
   "note": {
    "text": "Changing nitrogen gas into a usable form is nitrogen fixation. Only certain bacteria can do it.",
    "remember": "Fixation: bacteria make nitrogen usable."
   }
  },
  {
   "type": "trace",
   "title": "Lightning",
   "structure": "bolt",
   "instruction": "Trace the lightning bolt.",
   "note": {
    "text": "Lightning's energy can also fix nitrogen."
   }
  },
  {
   "type": "trace",
   "title": "Into the soil",
   "structure": "strike",
   "instruction": "Draw the arrow from the lightning to the soil.",
   "note": {
    "text": "Rain carries the fixed nitrogen down into the soil."
   }
  },
  {
   "type": "trace",
   "title": "Uptake",
   "structure": "uptake",
   "instruction": "Draw the arrow from the soil nitrates to the plant's roots.",
   "note": {
    "text": "Plant roots take in nitrates from the soil and use the nitrogen to build proteins."
   }
  },
  {
   "type": "trace",
   "title": "Rabbit",
   "structure": "rabbit",
   "instruction": "Trace the rabbit.",
   "note": {
    "text": "Animals get nitrogen by eating."
   }
  },
  {
   "type": "trace",
   "title": "Eating",
   "structure": "eat",
   "instruction": "Draw the arrow from the plant to the rabbit.",
   "note": {
    "text": "The rabbit uses the nitrogen in plant proteins to build its own proteins."
   }
  },
  {
   "type": "trace",
   "title": "Bacteria",
   "structure": "bacteria",
   "instruction": "Trace the soil bacteria.",
   "note": {
    "text": "Decomposers break down wastes and dead things, releasing ammonia into the soil."
   }
  },
  {
   "type": "trace",
   "title": "Decomposition",
   "structure": "decay",
   "instruction": "Draw the arrow from the rabbit down to the bacteria.",
   "note": {
    "text": "Wastes and dead bodies return their nitrogen to the soil."
   }
  },
  {
   "type": "trace",
   "title": "Nitrates",
   "structure": "nitrify",
   "instruction": "Draw the arrow from the bacteria to the nitrates.",
   "note": {
    "text": "Other bacteria change the ammonia into nitrates, which plants can take up again."
   }
  },
  {
   "type": "trace",
   "title": "Back to the air",
   "structure": "denitrify",
   "instruction": "Draw the arrow from the bacteria up to the air.",
   "note": {
    "text": "Some bacteria turn nitrates back into nitrogen gas, completing the cycle."
   }
  },
  {
