  {
   "type": "choice",
   "title": "Why bacteria matter",
   "instruction": "Use the model.",
   "showsDiagram": true,
   "question": "Nitrogen gas is all around plants. Why do they still depend on bacteria?",
   "options": [
    {
     "text": "Plants can't use nitrogen gas; bacteria change it into a form they can",
     "correct": true,
     "feedback": "Yes. Without nitrogen-fixing bacteria, very little nitrogen would enter the living world."
    },
    {
     "text": "Bacteria eat the plants",
     "feedback": "These bacteria help plants. They fix nitrogen into a usable form."
    },
    {
     "text": "Bacteria make oxygen for roots",
     "feedback": "They fix nitrogen, changing the gas into a form plants can use."
    },
    {
     "text": "They don't depend on bacteria",
     "feedback": "Plants can't use nitrogen gas themselves. Bacteria make it usable."
    }
   ]
  },
  {
   "type": "choice",
   "title": "Farmers",
   "instruction": "Apply the model.",
   "showsDiagram": true,
   "question": "Farmers often plant beans in a field one year and corn the next. Why does this help the corn?",
   "options": [
    {
     "text": "Bacteria in the bean roots add usable nitrogen to the soil",
     "correct": true,
     "feedback": "Right. The nodule bacteria fix nitrogen, enriching the soil for the next crop."
    },
    {
     "text": "Beans add oxygen to the soil",
     "feedback": "The key is nitrogen: bean root bacteria fix it into the soil."
    },
    {
     "text": "Beans scare away insects",
     "feedback": "The benefit is nitrogen fixed by bacteria in bean roots."
    },
    {
     "text": "Corn and beans are the same plant",
     "feedback": "They're different. Beans' root bacteria fix nitrogen for the corn."
    }
   ]
