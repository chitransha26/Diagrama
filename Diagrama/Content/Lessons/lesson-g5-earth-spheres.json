  {
   "type": "choice",
   "title": "Interactions",
   "instruction": "Two spheres at work.",
   "showsDiagram": true,
   "question": "A tree's roots grow into cracks in a rock and slowly break it apart. Which two spheres are interacting?",
   "options": [
    {
     "text": "Biosphere and geosphere",
     "correct": true,
     "feedback": "Yes. The roots are part of a living thing (biosphere) breaking up rock (geosphere)."
    },
    {
     "text": "Atmosphere and hydrosphere",
     "feedback": "No air or water is involved here: it's living roots and rock."
    },
    {
     "text": "Hydrosphere and geosphere",
     "feedback": "The rock is geosphere, but roots belong to a living thing: the biosphere."
    },
    {
     "text": "Only the biosphere",
     "feedback": "The roots are biosphere, but the rock they break is geosphere."
    }
   ]
  },
  {
   "type": "choice",
   "title": "Interactions",
   "instruction": "One more pair.",
   "showsDiagram": true,
   "question": "The sun warms the ocean, water evaporates, and it forms a cloud. Which two spheres are interacting?",
   "options": [
    {
     "text": "Hydrosphere and atmosphere",
     "correct": true,
     "feedback": "Right. Water (hydrosphere) moves into the air (atmosphere) as vapor, then forms clouds."
    },
    {
     "text": "Geosphere and biosphere",
     "feedback": "No rock or living things here. Water is moving into the air."
    },
    {
     "text": "Biosphere and atmosphere",
     "feedback": "The ocean water is hydrosphere, not a living thing."
    },
    {
     "text": "Geosphere and hydrosphere",
     "feedback": "The cloud is up in the air, so the atmosphere is involved."
    }
   ]
  }
 ]
