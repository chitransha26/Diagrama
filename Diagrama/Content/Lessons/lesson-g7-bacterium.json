  {
   "type": "choice",
   "title": "Compare",
   "instruction": "Compare with your own cells.",
   "showsDiagram": true,
   "question": "What's the biggest difference between a bacterium and one of your body's cells?",
   "options": [
    {
     "text": "The bacterium has no nucleus or other membrane-bound organelles",
     "correct": true,
     "feedback": "Yes. That's what makes it a prokaryote. Your cells keep their DNA in a nucleus."
    },
    {
     "text": "The bacterium has no DNA",
     "feedback": "All cells have DNA. A bacterium's just isn't inside a nucleus."
    },
    {
     "text": "The bacterium has no ribosomes",
     "feedback": "All cells have ribosomes. The difference is the missing nucleus."
    },
    {
     "text": "The bacterium is bigger",
     "feedback": "Bacteria are usually much smaller: 0.1 to 5 micrometres, versus 10 to 100 for our cells."
    }
   ]
  },
  {
   "type": "choice",
   "title": "Alive?",
   "instruction": "Think about what a cell is.",
   "showsDiagram": false,
   "question": "A bacterium is a single cell. Is it a living thing?",
   "options": [
    {
     "text": "Yes: a single cell can be a whole living organism",
     "correct": true,
     "feedback": "Right. Some living things are one cell; others, like you, are made of trillions."
    },
    {
     "text": "No: living things need many cells",
     "feedback": "Bacteria are alive, and each is just one cell."
    },
    {
     "text": "Only when it swims",
     "feedback": "A bacterium is alive whether it's moving or not."
    },
    {
     "text": "No, it's too small",
     "feedback": "Size doesn't decide it. A single bacterial cell is a living organism."
    }
   ]
  }
 ]
