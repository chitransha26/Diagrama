  {
   "type": "trace",
   "title": "Capsule",
   "structure": "capsule",
   "instruction": "Trace the outer capsule.",
   "note": {
    "text": "Many bacteria have a sticky capsule that lets them cling to surfaces."
   }
  },
  {
   "type": "trace",
   "title": "Cell wall",
   "structure": "wall",
   "instruction": "Trace the cell wall.",
   "note": {
    "text": "The cell wall protects the cell, holds its shape and stops it drying out."
   }
  },
  {
   "type": "trace",
   "title": "Cell membrane",
   "structure": "membrane",
   "instruction": "Trace the membrane just inside the wall.",
   "note": {
    "text": "Every cell has a membrane, cytoplasm, DNA and ribosomes, from bacteria to you.",
    "remember": "All cells share four parts."
   }
  },
  {
   "type": "trace",
   "title": "DNA",
   "structure": "dna",
   "instruction": "Trace the tangled loop of DNA in the middle.",
   "note": {
    "text": "A bacterium has no nucleus. Its DNA sits loose in the middle, in an area called the nucleoid.",
    "remember": "Prokaryote: no nucleus."
   }
  },
  {
   "type": "trace",
   "title": "Ribosomes",
   "structure": "ribo",
   "instruction": "Dab a dot for each ribosome.",
   "note": {
    "text": "Ribosomes build the cell's proteins."
   }
  },
  {
   "type": "trace",
   "title": "Flagellum",
   "structure": "flagellum",
   "instruction": "Draw the wavy flagellum at the end.",
   "note": {
    "text": "Some bacteria swim with a whip-like flagellum."
   }
  },
  {
   "type": "trace",
   "title": "Pili",
   "structure": "pili",
   "instruction": "Draw the six short pili.",
   "note": {
    "text": "Pili are short hairs. Bacteria use them to pass DNA to each other."
   }
  },
