 "steps": [
  {
   "type": "trace",
   "title": "Sun",
   "structure": "sun",
   "instruction": "Trace the sun.",
   "note": {
    "text": "Sunlight shines into the top layer of the ocean. Ocean food chains start there."
   }
  },
  {
   "type": "trace",
   "title": "Sun's rays",
   "structure": "sun",
   "part": "details",
   "instruction": "Draw the sun's rays.",
   "note": {
    "text": "Sunlight only reaches the top layer of the ocean, so that's where phytoplankton live."
   }
  },
  {
   "type": "trace",
   "title": "Ocean surface",
   "structure": "surface",
   "instruction": "Trace the wavy ocean surface.",
   "note": {
    "text": "This is the cold Southern Ocean, around Antarctica."
   }
  },
  {
   "type": "trace",
   "title": "Phytoplankton",
   "structure": "phyto",
   "instruction": "Trace the five phytoplankton near the surface.",
   "note": {
    "text": "Phytoplankton are tiny living things that make food from sunlight, like plants do. Shown much bigger than real.",
    "remember": "Phytoplankton = the ocean's producers."
   }
  },
  {
   "type": "trace",
   "title": "Krill",
   "structure": "krill",
   "instruction": "Trace the krill's body, its tail fan and two long feelers.",
   "note": {
    "text": "Krill are small shrimp-like animals. They eat phytoplankton and algae that grow under sea ice."
   }
  },
  {
   "type": "trace",
   "title": "Krill eye and legs",
   "structure": "krill",
   "part": "details",
   "instruction": "Draw the krill's eye and its three legs.",
   "note": {
    "text": "Krill swarm in huge numbers, so many animals can feed on them."
   }
  },
  {
   "type": "trace",
   "title": "Whale",
   "structure": "whale",
   "instruction": "Trace the whale's body, tail flukes and long flipper.",
   "note": {
    "text": "Whales, seals, fish and penguins all depend on eating krill. Here, a whale is the next link.",
    "remember": "Many animals depend on krill."
   }
  },
  {
   "type": "trace",
   "title": "Whale face",
   "structure": "whale",
   "part": "details",
   "instruction": "Draw the whale's eye, mouth and throat grooves.",
   "note": {
    "text": "A whale is a consumer: it can't make its own food."
   }
  },
  {
   "type": "trace",
   "title": "The chain",
   "structure": "chain",
   "instruction": "Draw the arrows: sun to phytoplankton, to krill, to whale.",
   "note": {
    "text": "Arrows point from the food to the eater. Matter and energy move along the chain this way.",
    "remember": "Arrow: from food to eater."
   }
  },
  {
   "type": "order",
   "title": "Build the chain",
   "items": [
    "Sun",
    "Phytoplankton",
    "Krill",
    "Whale"
   ],
   "instruction": "Tap them in order, starting where the energy begins.",
   "why": "Phytoplankton capture the sun's energy, krill eat phytoplankton, and whales eat krill.",
   "hint": "Which living thing makes its own food?"
  },
  {
   "type": "choice",
   "title": "Predict",
   "instruction": "Change the chain.",
   "showsDiagram": true,
   "question": "Melting sea ice means less algae for krill to eat, so there are fewer krill. What happens to the whales?",
   "options": [
    {
     "text": "They have less food, so it's harder for them to survive",
     "correct": true,
     "feedback": "Yes. Whales depend on krill. A change at the bottom of a food chain affects everything above it."
    },
    {
     "text": "Nothing: whales eat phytoplankton",
     "feedback": "In this chain, whales eat krill. Fewer krill means less food for whales."
    },
    {
     "text": "They have more food",
     "feedback": "Fewer krill means less food for whales, not more."
    },
    {
     "text": "The whales make their own food",
     "feedback": "Whales are consumers: they can't make food. They depend on krill."
    }
   ]
  },
  {
   "type": "choice",
   "title": "Producers",
   "instruction": "Find the producer.",
   "showsDiagram": true,
   "question": "Which living thing in this chain is the producer?",
   "options": [
    {
     "text": "Phytoplankton",
     "correct": true,
     "feedback": "Right. Phytoplankton make food from sunlight, so they're the producers."
    },
    {
     "text": "Krill",
     "feedback": "Krill eat phytoplankton, so they're consumers. The phytoplankton make the food."
    },
    {
     "text": "Whale",
     "feedback": "Whales eat krill, so they're consumers. The producers are the phytoplankton."
    },
    {
     "text": "The sun",
     "feedback": "The sun gives the energy, but it isn't alive. The producers are the phytoplankton."
    }
   ]
  }
 ]
