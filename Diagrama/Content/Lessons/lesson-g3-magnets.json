 "steps": [
  {
   "type": "trace",
   "title": "Magnets",
   "structure": "attract",
   "instruction": "Trace the two top magnets.",
   "note": {
    "text": "Every magnet has two ends, called poles: north (N) and south (S). The magnetic force is strongest at the poles."
   }
  },
  {
   "type": "trace",
   "title": "Poles",
   "structure": "attract",
   "part": "details",
   "instruction": "Draw the line splitting each magnet into its two poles.",
   "note": {
    "text": "Here, the south pole of one magnet faces the north pole of the other.",
    "remember": "Opposite poles attract."
   }
  },
  {
   "type": "trace",
   "title": "Attract",
   "structure": "attractArrows",
   "instruction": "Draw the arrows showing the magnets pulling together.",
   "note": {
    "text": "Opposite poles pull toward each other, even without touching. Magnetic force can act across a gap."
   }
  },
  {
   "type": "trace",
   "title": "Magnets",
   "structure": "repel",
   "instruction": "Trace the two bottom magnets.",
   "note": {
    "text": "This time the second magnet is turned around, so two south poles face each other."
   }
  },
  {
   "type": "trace",
   "title": "Poles",
   "structure": "repel",
   "part": "details",
   "instruction": "Draw the line splitting each magnet into its two poles.",
   "note": {
    "text": "Look at the letters in the middle: S faces S.",
    "remember": "Same poles repel."
   }
  },
  {
   "type": "trace",
   "title": "Repel",
   "structure": "repelArrows",
   "instruction": "Draw the arrows showing the magnets pushing apart.",
   "note": {
    "text": "Like poles push each other away. You can feel this push when you try to force them together."
   }
  },
  {
   "type": "choice",
   "title": "Predict",
   "instruction": "Use the magnets you drew.",
   "showsDiagram": true,
   "question": "You turn the bottom-right magnet around so its N faces the other magnet's S. What happens?",
   "options": [
    {
     "text": "They attract",
     "correct": true,
     "feedback": "Yes. Now opposite poles face each other, so they pull together."
    },
    {
     "text": "They repel even harder",
     "feedback": "Repelling happens when the same poles face each other. N and S are opposites."
    },
    {
     "text": "Nothing changes",
     "feedback": "Turning a magnet around swaps which pole faces the other magnet, which changes the force."
    },
    {
     "text": "They lose their magnetism",
     "feedback": "Turning a magnet doesn't remove its magnetism. It changes which poles face each other."
    }
   ]
  }
 ]
