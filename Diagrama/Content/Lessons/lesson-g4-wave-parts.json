 "steps": [
  {
   "type": "trace",
   "title": "Calm water",
   "structure": "rest",
   "instruction": "Trace the straight line where calm water would be.",
   "note": {
    "text": "This line shows where the water would sit if there were no waves. We measure the wave from here."
   }
  },
  {
   "type": "trace",
   "title": "Wave",
   "structure": "wave",
   "instruction": "Trace the wave, up and down along the water.",
   "note": {
    "text": "The highest points are crests; the lowest points are troughs. A wave repeats this pattern again and again.",
    "remember": "Crest = top, trough = bottom."
   }
  },
  {
   "type": "trace",
   "title": "Wavelength",
   "structure": "wavelength",
   "instruction": "Draw the line from one crest to the next.",
   "note": {
    "text": "The wavelength is the distance from one crest to the next crest. Short waves have crests close together.",
    "remember": "Wavelength: crest to crest."
   }
  },
  {
   "type": "trace",
   "title": "Amplitude",
   "structure": "amplitude",
   "instruction": "Draw the arrow from the calm line up to a crest.",
   "note": {
    "text": "The amplitude is how high the wave rises above the calm line. Bigger waves have a bigger amplitude.",
    "remember": "Amplitude: how tall."
   }
  },
  {
   "type": "trace",
   "title": "Floating ball",
   "structure": "ball",
   "instruction": "Trace the ball floating in a trough.",
   "note": {
    "text": "As waves pass, a floating ball bobs up and down. Waves can make objects move!",
    "remember": "Waves can move things."
   }
  },
  {
   "type": "label",
   "title": "Label the wave",
   "instruction": "Pick the right name for each numbered part.",
   "targets": [
    {
     "n": 1,
     "at": [
      180,
      400
     ],
     "answer": "Crest",
     "role": "The highest point."
    },
    {
     "n": 2,
     "at": [
      380,
      640
     ],
     "answer": "Trough",
     "role": "The lowest point.",
     "mistakes": {
      "Crest": "Crests are the tops. This low point is a trough."
     }
    },
    {
     "n": 3,
     "at": [
      380,
      330
     ],
     "answer": "Wavelength",
     "role": "Crest to crest."
    },
    {
     "n": 4,
     "at": [
      580,
      470
     ],
     "answer": "Amplitude",
     "role": "How high the wave rises."
    }
   ],
   "vocabulary": [
    "Crest",
    "Trough",
    "Wavelength",
    "Amplitude",
    "Shore"
   ]
  },
  {
   "type": "choice",
   "title": "Predict",
   "instruction": "Think about the ball.",
   "showsDiagram": true,
   "question": "A storm makes waves with a much bigger amplitude. What happens to the floating ball?",
   "options": [
    {
     "text": "It bobs up and down much farther",
     "correct": true,
     "feedback": "Yes. Taller waves lift it higher and drop it lower: the ball's motion follows the wave's amplitude."
    },
    {
     "text": "It stops moving",
     "feedback": "Bigger waves move it more, not less."
    },
    {
     "text": "It moves up and down the same amount",
     "feedback": "The amplitude changed, so the ball's bobbing changes too: it moves farther."
    },
    {
     "text": "It sinks",
     "feedback": "A ball still floats. Bigger waves just make it bob farther up and down."
    }
   ]
  }
