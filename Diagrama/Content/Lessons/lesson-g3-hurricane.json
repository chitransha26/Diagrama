 "steps": [
  {
   "type": "trace",
   "title": "Eye",
   "structure": "eye",
   "instruction": "Trace the eye in the center.",
   "note": {
    "text": "The eye is the calm center of the storm. Skies can be clear and winds light here.",
    "remember": "Calm in the eye, but the storm isn't over."
   }
  },
  {
   "type": "trace",
   "title": "Eyewall",
   "structure": "eyewall",
   "instruction": "Trace the ring around the eye.",
   "note": {
    "text": "The eyewall is a ring of towering clouds. It has the strongest winds and heaviest rain of the whole storm."
   }
  },
  {
   "type": "trace",
   "title": "Rain bands",
   "structure": "bands",
   "instruction": "Draw the three curving rain bands.",
   "note": {
    "text": "Rain bands are long arms of clouds spiraling in toward the center, bringing bursts of heavy rain and gusty wind."
   }
  },
  {
   "type": "trace",
   "title": "Wind direction",
   "structure": "wind",
   "instruction": "Draw an arrowhead at the inner end of each band.",
   "note": {
    "text": "Air spirals inward counterclockwise in the Northern Hemisphere, because of Earth's spin. South of the equator it's clockwise.",
    "remember": "North: counterclockwise."
   }
  },
  {
   "type": "choice",
   "title": "Explain",
   "instruction": "Use what you've drawn.",
   "showsDiagram": true,
   "question": "Where are a hurricane's strongest winds?",
   "options": [
    {
     "text": "In the eyewall",
     "correct": true,
     "feedback": "Yes. The ring of clouds around the eye has the fastest winds."
    },
    {
     "text": "In the eye",
     "feedback": "The eye is the calm center. The strongest winds circle right around it."
    },
    {
     "text": "At the outer edge",
     "feedback": "Winds get stronger closer to the center, peaking at the eyewall."
    },
    {
     "text": "Everywhere equally",
     "feedback": "Winds vary a lot. They're strongest at the eyewall."
    }
   ]
  },
  {
   "type": "choice",
   "title": "Stay safe",
   "instruction": "Hurricanes are a weather hazard.",
   "showsDiagram": false,
   "question": "Which idea best reduces harm when a hurricane is coming?",
   "options": [
    {
     "text": "Use forecasts to leave early and protect windows with shutters",
     "correct": true,
     "feedback": "Yes. Forecasts give days of warning, and shutters, strong roofs and leaving low areas reduce damage and keep people safe."
    },
    {
     "text": "Go outside when the eye passes over",
     "feedback": "The calm eye is followed by the eyewall's strongest winds. Stay inside."
    },
    {
     "text": "Wait until the rain starts to prepare",
     "feedback": "By then it's dangerous to travel. Prepare early."
    },
    {
     "text": "Open windows to let wind through",
     "feedback": "This doesn't protect a house. Shutters and closed windows are safer."
    }
   ]
  }
 ]
