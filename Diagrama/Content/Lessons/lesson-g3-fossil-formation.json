 "steps": [
  {
   "type": "trace",
   "title": "Lake",
   "structure": "lake",
   "instruction": "In picture 1, trace the water's surface and the lake bottom.",
   "note": {
    "text": "Most fossils form in water, where mud and sand can quickly cover a body.",
    "remember": "Fossils need fast burial."
   }
  },
  {
   "type": "trace",
   "title": "Fish",
   "structure": "deadFish",
   "instruction": "Trace the fish lying on the lake bottom.",
   "note": {
    "text": "When an animal dies, its body sinks. Soon only its hard parts, like bones, teeth and shells, are left."
   }
  },
  {
   "type": "trace",
   "title": "Mud layers",
   "structure": "buried",
   "instruction": "In picture 2, trace the lake bottom and the layers of mud on top.",
   "note": {
    "text": "Rivers wash mud and sand over the bones, layer after layer. These layers are called sediment."
   }
  },
  {
   "type": "trace",
   "title": "Bones",
   "structure": "buried",
   "part": "details",
   "instruction": "Draw the skeleton under the mud.",
   "note": {
    "text": "Buried bones are protected from scavengers and weather, so they don't fall apart."
   }
  },
  {
   "type": "trace",
   "title": "Rock layers",
   "structure": "rock",
   "instruction": "In picture 3, trace the many layers piled on top.",
   "note": {
    "text": "Over millions of years the weight of new layers presses the old ones into solid rock.",
    "remember": "Deeper layers are older."
   }
  },
  {
   "type": "trace",
   "title": "Fossil",
   "structure": "rock",
   "part": "details",
   "instruction": "Draw the bones, now turned to stone.",
   "note": {
    "text": "Minerals carried by groundwater fill the tiny spaces in the bones and slowly replace them, turning them to stone."
   }
  },
  {
   "type": "trace",
   "title": "Erosion",
   "structure": "exposed",
   "instruction": "In picture 4, trace the worn-away hillside.",
   "note": {
    "text": "The rock is pushed up into land. Wind and water wear it away until the fossil reaches the surface."
   }
  },
  {
   "type": "trace",
   "title": "Found!",
   "structure": "exposed",
   "part": "details",
   "instruction": "Draw the fossil near the surface.",
   "note": {
    "text": "Scientists study fossils to learn which organisms lived long ago and what their environments were like."
   }
  },
  {
   "type": "order",
   "title": "In order",
   "items": [
    "Fish dies and sinks",
    "Buried by mud",
    "Bones turn to stone",
    "Erosion exposes it"
   ],
   "instruction": "Tap the steps in the order they happen.",
   "why": "A body is buried quickly, its bones are replaced by minerals deep in rock, and erosion later brings it to the surface.",
   "hint": "What has to cover the bones first?"
  },
  {
   "type": "choice",
   "title": "Explain",
   "instruction": "Use what you've drawn.",
   "showsDiagram": true,
   "question": "Scientists find a fish fossil on top of a dry mountain. What does that tell them?",
   "options": [
    {
     "text": "The area was once under water",
     "correct": true,
     "feedback": "Yes. Fish live in water, so this rock formed in a lake or sea long ago and was later pushed up."
    },
    {
     "text": "Fish used to live on mountains",
     "feedback": "Fish have always needed water. The land moved, not the fish's habits."
    },
    {
     "text": "A bird dropped it there",
     "feedback": "The fossil formed inside the rock layers, so it formed where it lies."
    },
    {
     "text": "It tells us nothing",
     "feedback": "Fossils are evidence of past life and past environments."
    }
   ]
  }
 ]
