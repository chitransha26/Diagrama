 "steps": [
  {
   "type": "trace",
   "title": "Cell",
   "structure": "cell",
   "instruction": "Trace the heart muscle cell.",
   "note": {
    "text": "Cells are the smallest units of life. In humans, cells carry out all the functions of life.",
    "remember": "Level 1: cell."
   }
  },
  {
   "type": "trace",
   "title": "Nucleus",
   "structure": "cell",
   "part": "details",
   "instruction": "Draw its nucleus.",
   "note": {
    "text": "Each heart muscle cell can shorten, or contract."
   }
  },
  {
   "type": "trace",
   "title": "Tissue",
   "structure": "tissue",
   "instruction": "Trace the nine cells joined together.",
   "note": {
    "text": "A tissue is a group of similar cells working together. Heart muscle cells form heart muscle tissue.",
    "remember": "Level 2: tissue."
   }
  },
  {
   "type": "trace",
   "title": "Organ",
   "structure": "organ",
   "instruction": "Trace the heart.",
   "note": {
    "text": "An organ is built from two or more kinds of tissue. The heart has muscle, nerve and other tissues.",
    "remember": "Level 3: organ."
   }
  },
  {
   "type": "trace",
   "title": "Organ system",
   "structure": "system",
   "instruction": "Trace the small heart and the loop of blood vessels.",
   "note": {
    "text": "An organ system is a group of organs working together. The heart and blood vessels form the circulatory system.",
    "remember": "Level 4: organ system."
   }
  },
  {
   "type": "trace",
   "title": "Organism",
   "structure": "organism",
   "instruction": "Trace the person.",
   "note": {
    "text": "Eleven organ systems work together to keep one whole organism alive: you.",
    "remember": "Level 5: organism."
   }
  },
  {
   "type": "trace",
   "title": "Building up",
   "structure": "arrows",
   "instruction": "Draw the four arrows from smallest to largest.",
   "note": {
    "text": "Each level is built from the one before it."
   }
  },
  {
   "type": "order",
   "title": "Smallest to largest",
   "items": [
    "Cell",
    "Tissue",
    "Organ",
    "Organ system",
    "Organism"
   ],
   "instruction": "Tap the levels in order, smallest first.",
   "why": "Cells form tissues, tissues form organs, organs form organ systems, and organ systems make up the organism.",
   "hint": "Start with the smallest living unit."
  },
