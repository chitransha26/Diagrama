  {
   "type": "choice",
   "title": "Argue",
   "instruction": "Use the model.",
   "showsDiagram": true,
   "question": "Heart muscle cells stop getting oxygen. Why can this harm the whole body?",
   "options": [
    {
     "text": "The cells form the tissue that makes the heart pump, and the body depends on that blood flow",
     "correct": true,
     "feedback": "Yes. Each level depends on the one below: weak cells mean a weak heart, and every system needs blood."
    },
    {
     "text": "It can't: cells are too small to matter",
     "feedback": "Everything the body does is done by cells. The levels depend on each other."
    },
    {
     "text": "Only the heart is affected",
     "feedback": "The heart pumps blood to every organ, so the whole body is affected."
    },
    {
     "text": "Other cells will grow a new heart",
     "feedback": "The body can't grow a new heart. Damaged heart cells affect the whole system."
    }
   ]
  }
 ]
