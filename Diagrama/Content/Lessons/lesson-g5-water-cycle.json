 "steps": [
  {
   "type": "trace",
   "title": "Sun",
   "structure": "sun",
   "instruction": "Trace the sun.",
   "note": {
    "text": "The sun's energy drives the whole water cycle by warming the ocean and other water.",
    "remember": "The sun powers the water cycle."
   }
  },
  {
   "type": "trace",
   "title": "Sun's rays",
   "structure": "sun",
   "part": "details",
   "instruction": "Draw the sun's rays.",
   "note": {
    "text": "Sunlight warms the ocean's surface water."
   }
  },
  {
   "type": "trace",
   "title": "Ocean",
   "structure": "sea",
   "instruction": "Trace the ocean's wavy surface.",
   "note": {
    "text": "Most of Earth's water is in the ocean."
   }
  },
  {
   "type": "trace",
   "title": "Mountain",
   "structure": "mountain",
   "instruction": "Trace the mountain.",
   "note": {
    "text": "Land is part of the cycle too. Water falls on it and flows back to the sea."
   }
  },
  {
   "type": "trace",
   "title": "Evaporation",
   "structure": "evaporation",
   "instruction": "Draw the two arrows rising from the ocean.",
   "note": {
    "text": "Warmed by the sun, liquid water evaporates: it turns into water vapor, an invisible gas, and rises into the air.",
    "remember": "Evaporation: liquid to gas."
   }
  },
  {
   "type": "trace",
   "title": "Cloud",
   "structure": "cloud",
   "instruction": "Trace the cloud.",
   "note": {
    "text": "High up, water vapor cools and condenses into tiny droplets or ice crystals. Together they make a cloud.",
    "remember": "Condensation: gas to liquid."
   }
  },
  {
   "type": "trace",
   "title": "Condensation",
   "structure": "condensation",
   "instruction": "Draw the arrow from the rising vapor to the cloud.",
   "note": {
    "text": "Water vapor moves through the air: the hydrosphere and atmosphere working together."
   }
  },
  {
   "type": "trace",
   "title": "Precipitation",
   "structure": "rain",
   "instruction": "Draw the three lines of rain.",
   "note": {
    "text": "When the drops grow heavy, they fall as precipitation: rain or snow.",
    "remember": "Precipitation: rain or snow."
   }
  },
  {
   "type": "trace",
   "title": "Runoff",
   "structure": "runoff",
   "instruction": "Draw the arrow of water flowing down the mountain to the ocean.",
   "note": {
    "text": "Some rain soaks into the ground. Some runs off in streams and rivers, back to the ocean, and the cycle repeats.",
    "remember": "Runoff flows back to the sea."
   }
  },
  {
   "type": "label",
