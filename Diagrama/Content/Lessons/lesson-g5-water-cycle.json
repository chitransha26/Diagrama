   "instruction": "Think about where the water goes.",
   "showsDiagram": true,
   "question": "A puddle disappears on a sunny day. Where did the water go?",
   "options": [
    {
     "text": "It evaporated into the air as water vapor",
     "correct": true,
     "feedback": "Yes. The sun warmed it, and it became an invisible gas in the air. Later it may condense into a cloud."
    },
    {
     "text": "It was destroyed by the sun",
     "feedback": "Water isn't destroyed. It evaporated into the air as water vapor."
    },
    {
     "text": "It turned into a cloud right away",
     "feedback": "First it evaporated into invisible vapor. Clouds form later, when vapor cools high up."
    },
    {
     "text": "It all soaked into the ground",
     "feedback": "Some might, but on a sunny day much of it evaporates into the air."
    }
   ]
